NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:7001
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-status-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-status-service-role-key

# Optional canonical URL used for auth redirects, invite links, and notification
# deep links. Vercel deployments automatically fall back to their production or
# preview URL when this is unset. Set this for a custom production domain.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Used only to bootstrap the first administrator while user_roles has no admin.
# After that, database roles are authoritative and additional admins must be
# assigned directly in Supabase/Postgres.
ADMIN_EMAIL=hello@simonbeirouti.com

# Public VAPID key exposed to the browser when a user opts into push notifications.
# Generate the key pair with: pnpm exec web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-public-vapid-key
VAPID_PRIVATE_KEY=replace-with-private-vapid-key

# Contact identity included in the VAPID handshake; use a reachable administrator email.
VAPID_SUBJECT=mailto:hello@simonbeirouti.com
